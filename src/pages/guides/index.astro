---
import BlogLayout from "../../layouts/BlogLayout.astro";
import { guides } from "../../data/guides";
import { getCollection } from "astro:content";

// Each guide is shown with the cover of its pillar (first) article.
const blog = await getCollection("blog");
const covers: Record<string, string | undefined> = Object.fromEntries(
  guides.map((g) => [g.slug, blog.find((p) => p.slug === g.posts[0])?.data.cover]),
);

const path = "/guides/";
const title = "Home Renovation Guides by Topic";
const description =
  "Guides that group the Home Stories articles: budgeting and contingency, hiring contractors, timelines and sequencing, and the apps and tools people actually use.";

const url = new URL(path, Astro.site).href;

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url,
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    name: "Home Stories",
    url: new URL("/", Astro.site).href,
  },
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["h1", "[data-speakable]"],
  },
  mainEntity: { "@id": `${url}#guides` },
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${url}#guides`,
  name: "Home renovation guides",
  numberOfItems: guides.length,
  itemListElement: guides.map((guide, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/guides/${guide.slug}/`, Astro.site).href,
    name: guide.h1,
  })),
};
---

<BlogLayout
  title={title}
  description={description}
  canonicalPath={path}
  extraSchema={[collectionSchema, itemListSchema]}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Guides", path },
  ]}
  hideAppBanner={true}
>
  <main class="hs-wrap pb-24 pt-10 md:pb-36 md:pt-16">
    <nav aria-label="Breadcrumb" class="hs-soft mb-10 md:mb-16">
      <a href="/" class="hover:underline">Home</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <a href="/blog/" class="hover:underline">Blog</a>
    </nav>

    <header class="hs-grid items-end gap-y-10">
      <h1 class="hs-display col-span-12 m-0" style="--chars: 19" data-reveal>
        <span class="block">Renovation guides,</span>
        <span class="block">grouped by the job</span>
      </h1>
      <div class="col-span-12 md:col-span-6">
        <p class="hs-lead m-0 mt-6 max-w-[38ch]" data-speakable data-reveal style="--d: 80ms">
          The articles are written to answer one question each. These four guides
          pull the related ones together: the money, the contractor, the timeline,
          and the tool you keep the record in.
        </p>
      </div>
      <figure class="col-span-12 m-0 overflow-hidden md:col-span-6" data-reveal style="--d: 140ms">
        <img
          src="/stock/09.webp"
          alt="A renovation plan on the table: printed drawings, a notebook, a calculator and a tape measure."
          width={1000}
          height={750}
          loading="eager"
          class="hs-drift aspect-[4/3] w-full object-cover"
        />
      </figure>
    </header>

    <ol class="m-0 mt-20 list-none space-y-3 p-0 md:mt-28">
      {
        guides.map((guide, i) => (
          <li class="m-0" data-reveal style={`--d: ${i * 70}ms`}>
            <a href={`/guides/${guide.slug}/`} class="hs-row hs-grid items-center gap-y-4 py-6">
              {covers[guide.slug] && (
                <span class="col-span-12 block overflow-hidden sm:col-span-4 md:col-span-3">
                  <img src={covers[guide.slug]} alt="" width={640} height={400} loading="lazy" class="aspect-[16/10] w-full object-cover" />
                </span>
              )}
              <span class="col-span-12 sm:col-span-8 md:col-span-9 lg:col-span-7">
                <span class="hs-lead block font-semibold">{guide.h1}</span>
                <span class="mt-2 block">{guide.metaDescription}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <p class="m-0 mt-14">
      Prefer the full list? <a href="/blog/" class="hs-link">Every article, newest first</a>.
    </p>
  </main>
</BlogLayout>
