---
import { getCollection } from "astro:content";
import { isPublished } from "../../utils/posts";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { guides } from "../../data/guides";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => isPublished(data));
  const bySlug = new Map(posts.map((post) => [post.slug, post]));

  return guides.map((guide) => {
    const missing = guide.posts.filter((slug) => !bySlug.has(slug));
    if (missing.length) {
      throw new Error(`Guide "${guide.slug}" links missing posts: ${missing.join(", ")}`);
    }
    return {
      params: { slug: guide.slug },
      props: {
        guide,
        posts: guide.posts.map((slug) => bySlug.get(slug)!),
      },
    };
  });
}

interface Props {
  guide: (typeof guides)[number];
  posts: Awaited<ReturnType<typeof getCollection<"blog">>>;
}

const { guide, posts } = Astro.props as Props;
const path = `/guides/${guide.slug}/`;
const url = new URL(path, Astro.site).href;
const siblings = guides.filter((item) => item.slug !== guide.slug);

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: guide.h1,
  description: guide.metaDescription,
  url,
  inLanguage: "en",
  isPartOf: {
    "@type": "WebSite",
    name: "Home Stories",
    url: new URL("/", Astro.site).href,
  },
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["h1", "[data-speakable]"],
  },
  mainEntity: { "@id": `${url}#articles` },
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${url}#articles`,
  name: guide.h1,
  numberOfItems: posts.length,
  itemListElement: posts.map((post, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/blog/${post.slug}/`, Astro.site).href,
    name: post.data.title,
  })),
};
---

<BlogLayout
  title={guide.metaTitle}
  description={guide.metaDescription}
  canonicalPath={path}
  extraSchema={[collectionSchema, itemListSchema]}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Guides", path: "/guides/" },
    { name: guide.label, path },
  ]}
  hideAppBanner={true}
>
  <main class="hs-wrap pb-24 pt-10 md:pb-36 md:pt-16">
    <nav aria-label="Breadcrumb" class="hs-soft mb-10 md:mb-16">
      <a href="/" class="hover:underline">Home</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <a href="/guides/" class="hover:underline">Guides</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span>{guide.label}</span>
    </nav>

    <header class="hs-grid gap-y-8">
      <h1 class="hs-title col-span-12 m-0 max-w-[34ch]" data-reveal>{guide.h1}</h1>
      <div class="col-span-12 md:col-span-6">
      <div class="space-y-4" data-speakable data-reveal style="--d: 80ms">
        {guide.intro.map((paragraph, i) => <p class={`m-0 max-w-[52ch] ${i === 0 ? "hs-lead" : ""}`}>{paragraph}</p>)}
      </div>
      </div>
      {posts[0]?.data.cover && (
        <figure class="col-span-12 m-0 overflow-hidden md:col-span-6" data-reveal style="--d: 140ms">
          <img
            src={posts[0].data.cover}
            alt={posts[0].data.coverAlt ?? ""}
            width={1600}
            height={700}
            loading="eager"
            class="hs-drift aspect-[4/3] w-full object-cover md:aspect-[4/5]"
          />
        </figure>
      )}
    </header>

    <ol class="m-0 mt-16 list-none space-y-3 p-0 md:mt-24">
      {
        posts.map((post, i) => (
          <li class="m-0" data-reveal style={`--d: ${(i % 4) * 60}ms`}>
            <a href={`/blog/${post.slug}/`} class="hs-row hs-grid items-center gap-y-4 py-5">
              {post.data.cover && (
                <span class="col-span-12 block overflow-hidden sm:col-span-4 md:col-span-3">
                  <img
                    src={post.data.cover}
                    alt={post.data.coverAlt ?? ""}
                    width={640}
                    height={400}
                    loading={i < 2 ? "eager" : "lazy"}
                    decoding="async"
                    class="aspect-[16/10] w-full object-cover"
                  />
                </span>
              )}
              <span class="col-span-12 sm:col-span-8 md:col-span-9 lg:col-span-6">
                <span class="hs-lead block font-semibold">{post.data.title}</span>
                <span class="mt-2 block">{post.data.description}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="hs-grid mt-24 gap-y-12 md:mt-32">
      <aside class="col-span-12 md:col-span-5">
        <h2 class="hs-lead m-0 font-semibold">Other guides</h2>
        <ul class="m-0 mt-4 list-none space-y-2.5 p-0">
          {
            siblings.map((item) => (
              <li class="m-0">
                <a href={`/guides/${item.slug}/`} class="hs-link">{item.h1}</a>
              </li>
            ))
          }
          <li class="m-0">
            <a href="/blog/" class="hs-link">All renovation articles</a>
          </li>
        </ul>
      </aside>

      <aside class="hs-signal col-span-12 p-7 sm:p-10 md:col-span-7">
        <h2 class="hs-lead m-0 font-semibold">Keep the running total on the project</h2>
        <p class="m-0 mt-3 max-w-[52ch]">
          Home Stories is a free renovation tracker for iPhone and iPad. It works offline and needs no account.
          The budget-vs-actual chart, PDF export and iCloud sync are an optional one-time upgrade, not a subscription.
        </p>
        <a
          href="https://apps.apple.com/app/id6754754960"
          class="hs-btn hs-btn--ink mt-6"
          data-umami-event="appstore-click"
          data-umami-event-surface="guide-footer"
          data-umami-event-slug={guide.slug}
        >
          Get Home Stories — free on the App Store
        </a>
      </aside>
    </div>
  </main>
</BlogLayout>
