---
// Localized use-case hub, /<lang>/use-cases/. Lists the pages translated into
// that language and points to the English hub for the rest. #164
import BlogLayout from "../../../layouts/BlogLayout.astro";
import { getLocale, localeHref } from "../../../i18n/locales";
import {
  USE_CASE_LOCALES,
  localizedUseCases,
  useCaseHubAlternates,
  useCaseHref,
  useCaseHubHref,
  type LocalizedUseCase,
  type UseCaseLocaleFile,
} from "../../../i18n/useCases";

export function getStaticPaths() {
  return USE_CASE_LOCALES.map((file) => ({ file, entries: localizedUseCases(file.locale) }))
    .filter(({ entries }) => entries.length > 0)
    .map(({ file, entries }) => ({
      params: { lang: file.locale },
      props: { file, entries },
    }));
}

interface Props {
  file: UseCaseLocaleFile;
  entries: LocalizedUseCase[];
}

const { lang } = Astro.params as { lang: string };
const { file, entries } = Astro.props as Props;
const { ui, hub } = file;
const locale = getLocale(lang)!;
const path = useCaseHubHref(lang);
const homePath = localeHref(lang);
const url = new URL(path, Astro.site).href;
const longestLine = Math.max(...hub.h1.map((line) => line.length));

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: hub.metaTitle,
  description: hub.metaDescription,
  url,
  inLanguage: locale.hreflang,
  isPartOf: {
    "@type": "WebSite",
    name: "Home Stories",
    url: new URL(homePath, Astro.site).href,
  },
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: ["h1", "[data-speakable]"],
  },
  mainEntity: { "@id": `${url}#use-cases` },
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${url}#use-cases`,
  name: `Home Stories: ${ui.useCases}`,
  numberOfItems: entries.length,
  itemListElement: entries.map((useCase, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(useCaseHref(lang, useCase.slug), Astro.site).href,
    name: useCase.h1,
  })),
};
---

<BlogLayout
  title={hub.metaTitle}
  description={hub.metaDescription}
  canonicalPath={path}
  lang={lang}
  alternates={useCaseHubAlternates()}
  extraSchema={[collectionSchema, itemListSchema]}
  breadcrumbs={[
    { name: ui.home, path: homePath },
    { name: ui.useCases, path },
  ]}
  hideAppBanner={true}
>
  <main class="hs-wrap pb-24 pt-10 md:pb-36 md:pt-16">
    <nav aria-label="Breadcrumb" class="hs-soft mb-10 md:mb-16">
      <a href={homePath} class="hover:underline">{ui.home}</a>
    </nav>

    <header class="hs-grid items-end gap-y-10">
      <h1 class="hs-display col-span-12 m-0" style={`--chars: ${longestLine}`} data-reveal>
        {hub.h1.map((line) => <span class="block">{line}</span>)}
      </h1>
      <div class="col-span-12 md:col-span-6">
        <p class="hs-lead m-0 mt-6 max-w-[38ch]" data-speakable data-reveal style="--d: 80ms">{hub.intro}</p>
      </div>
      <figure class="col-span-12 m-0 overflow-hidden md:col-span-6" data-reveal style="--d: 140ms">
        <img
          src="/stock/13.webp"
          alt={hub.imageAlt}
          width={1024}
          height={768}
          loading="eager"
          class="hs-drift aspect-[4/3] w-full object-cover"
        />
      </figure>
    </header>

    <ul class="hs-grid m-0 mt-20 list-none gap-y-12 p-0 md:mt-28">
      {
        entries.map((useCase, i) => (
          <li class="col-span-12 m-0 sm:col-span-6 lg:col-span-4" data-reveal style={`--d: ${(i % 3) * 60}ms`}>
            <a href={useCaseHref(lang, useCase.slug)} class="group block">
              <span class="block overflow-hidden">
                <img
                  src={useCase.image}
                  alt=""
                  width={640}
                  height={480}
                  loading={i < 3 ? "eager" : "lazy"}
                  decoding="async"
                  class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                />
              </span>
              <span class="hs-lead mt-4 block font-semibold group-hover:underline">{useCase.label}</span>
              <span class="mt-2 block">{useCase.metaDescription}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="m-0 mt-16 max-w-[60ch]">
      {hub.englishNote} <a href={useCaseHubHref("en")} hreflang="en" class="hs-link">{hub.englishLink}</a>.
    </p>
  </main>
</BlogLayout>
