---
import { getCollection } from "astro:content"
import { isPublished } from "../../utils/posts";
import HomePage from "@modules/home"
import Layout from "Layout.astro"
import defaultTemplateConfig from "utils/config"
import { fetchAppStoreData, fallbackAppStoreData, toAppStoreMetadata, fetchStorefrontPricing } from "utils/appStoreData"
import { readingTime } from "utils/readingTime"
import { NON_DEFAULT_LOCALES } from "../../i18n/locales"
import { getLocalizedConfig } from "../../i18n/getConfig"
import type { TemplateConfig } from "utils/configType"

// One page per non-default locale: /de/, /fr/, /ja/, … English lives at the
// root (src/pages/index.astro). App Store data is fetched once here and handed
// to every locale via props, so the build makes a single network call.
export async function getStaticPaths() {
  const appStoreData = (await fetchAppStoreData()) ?? fallbackAppStoreData;
  const appStore = toAppStoreMetadata(appStoreData);
  // Self-hosted build-time copy of the App Store icon (see app-icon-512.jpg.ts). #74
  const logo = "/app-icon-512.jpg";

  const posts = (await getCollection("blog", ({ data }) => isPublished(data)))
    .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime())
    .slice(0, 3)
    .map((post) => ({
      slug: post.slug,
      title: post.data.title,
      description: post.data.description,
      date: post.data.publishDate.toLocaleDateString("en-US", {
        month: "short",
        day: "numeric",
      }),
      minutes: readingTime(post.body).minutes,
    }));

  // In-app purchase prices, read from each locale's own App Store storefront in
  // parallel so the build isn't sixteen serial round-trips. A storefront that
  // fails resolves to null and that locale keeps the config's fallback. #109
  const pricing = await Promise.all(
    NON_DEFAULT_LOCALES.map((l) => fetchStorefrontPricing(l.storefront)),
  );

  return NON_DEFAULT_LOCALES.map((l, i) => ({
    params: { lang: l.code },
    props: { appStore, logo, posts, pricing: pricing[i] },
  }));
}

const { lang } = Astro.params;
const { appStore, logo, posts, pricing } = Astro.props;

const baseConfig: TemplateConfig = {
  ...defaultTemplateConfig,
  logo,
  appStore,
};

const config = getLocalizedConfig(baseConfig, lang!, pricing);
---

<Layout {...config} isAppPage>
  <HomePage client:load config={config} posts={posts} />
</Layout>
