---
import BlogLayout from "../../layouts/BlogLayout.astro";
import FaqSection from "../../components/blog/FaqSection.astro";
import { features } from "../../data/features";
import { allUseCases, useCases } from "../../data/useCases";
import { appStoreUrl } from "../../utils/appStoreLink.mjs";

export function getStaticPaths() {
  const known = new Set(allUseCases.map((u) => u.slug));
  const live = new Map(useCases.map((u) => [u.slug, u]));

  return features.map((feature) => {
    const missing = feature.useCases.filter((slug) => !known.has(slug));
    if (missing.length) {
      throw new Error(`Feature "${feature.slug}" links unknown use cases: ${missing.join(", ")}`);
    }
    return {
      params: { slug: feature.slug },
      props: {
        feature,
        related: feature.useCases.filter((slug) => live.has(slug)).map((slug) => live.get(slug)!),
      },
    };
  });
}

interface Props {
  feature: (typeof features)[number];
  related: (typeof useCases)[number][];
}

const { feature, related } = Astro.props as Props;
const path = `/features/${feature.slug}/`;
const url = new URL(path, Astro.site).href;
const siblings = features.filter((item) => item.slug !== feature.slug);
const ctaUrl = appStoreUrl(`feat-${feature.slug}`);
const site = new URL("/", Astro.site).href;

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Home Stories: Renovation App",
  operatingSystem: "iOS 17.0 or later, iPadOS 17.0 or later",
  applicationCategory: "LifestyleApplication",
  url: site,
  installUrl: "https://apps.apple.com/app/id6754754960",
  screenshot: new URL(feature.screenshot.src, Astro.site).href,
  featureList: [feature.label, ...feature.sections.map((s) => s.title)],
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: feature.h1,
  description: feature.metaDescription,
  url,
  inLanguage: "en",
  primaryImageOfPage: new URL(feature.screenshot.src, Astro.site).href,
  isPartOf: { "@type": "WebSite", name: "Home Stories", url: site },
  speakable: { "@type": "SpeakableSpecification", cssSelector: ["h1", "[data-speakable]"] },
};

// Four cards sit 2 by 2 on wide screens; other counts keep three columns.
const cardSpan = feature.sections.length === 4 ? "lg:col-span-6" : "lg:col-span-4";
const portrait = feature.screenshot.height / feature.screenshot.width > 1.6;
---

<BlogLayout
  title={feature.metaTitle}
  description={feature.metaDescription}
  canonicalPath={path}
  extraSchema={[pageSchema, appSchema]}
  breadcrumbs={[
    { name: "Home", path: "/" },
    { name: "Features", path: "/features/" },
    { name: feature.label, path },
  ]}
  hideAppBanner={true}
>
  <main class="hs-wrap pb-24 pt-10 md:pb-36 md:pt-16">
    <nav aria-label="Breadcrumb" class="hs-soft mb-10 md:mb-16">
      <a href="/" class="hover:underline">Home</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <a href="/features/" class="hover:underline">Features</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span>{feature.label}</span>
    </nav>

    <header class="hs-grid items-start gap-y-10">
      <div class="col-span-12 md:col-span-7">
        {feature.pro ? <p class="hs-soft m-0 mb-4">Part of Home Stories Pro, a one-time purchase</p> : <p class="hs-soft m-0 mb-4">Free in Home Stories</p>}
        <h1 class="hs-title m-0 max-w-[24ch]" data-reveal>{feature.h1}</h1>
        <div class="mt-8 space-y-4" data-speakable data-reveal style="--d: 80ms">
          {feature.intro.map((paragraph, i) => <p class={`m-0 max-w-[52ch] ${i === 0 ? "hs-lead" : ""}`}>{paragraph}</p>)}
        </div>
        <a
          href={ctaUrl}
          class="hs-btn mt-8"
          data-umami-event="appstore-click"
          data-umami-event-surface="feature-hero"
          data-umami-event-slug={feature.slug}
        >
          Get Home Stories — free
        </a>
      </div>
      <figure
        class={`m-0 ${portrait ? "col-span-8 col-start-3 sm:col-span-6 sm:col-start-4 md:col-span-4 md:col-start-9" : "col-span-12 sm:col-span-10 sm:col-start-2 md:col-span-5 md:col-start-8"}`}
        data-reveal
        style="--d: 140ms"
      >
        <img
          src={feature.screenshot.src}
          alt={feature.screenshot.alt}
          width={feature.screenshot.width}
          height={feature.screenshot.height}
          loading="eager"
          class="w-full"
        />
        <figcaption class="hs-soft hs-small mt-3">{feature.screenshot.caption}</figcaption>
      </figure>
    </header>

    <section class="mt-20 md:mt-28" aria-labelledby="facts">
      <h2 id="facts" class="hs-lead m-0 font-semibold">The facts</h2>
      <dl class="m-0 mt-6 max-w-[72ch] border-t" style="border-color: color-mix(in srgb, currentColor 18%, transparent)">
        {
          feature.facts.map((fact) => (
            <div class="grid gap-1 border-b py-3 sm:grid-cols-[14rem_1fr] sm:gap-6" style="border-color: color-mix(in srgb, currentColor 18%, transparent)">
              <dt class="m-0 font-semibold">{fact.label}</dt>
              <dd class="m-0">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-20 md:mt-28" aria-labelledby="how">
      <h2 id="how" class="hs-lead m-0 font-semibold">How it works</h2>
      <ul class="hs-grid m-0 mt-8 list-none gap-y-8 p-0">
        {
          feature.sections.map((item, i) => (
            <li class={`col-span-12 m-0 sm:col-span-6 ${cardSpan}`} data-reveal style={`--d: ${(i % 3) * 60}ms`}>
              <h3 class="m-0 text-lg font-semibold">{item.title}</h3>
              <p class="m-0 mt-2 max-w-[44ch]">{item.body}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-20 md:mt-28" aria-labelledby="steps">
      <h2 id="steps" class="hs-lead m-0 font-semibold">How to start</h2>
      <ol class="m-0 mt-6 list-decimal space-y-3 pl-6">
        {feature.steps.map((step) => <li class="max-w-[60ch]">{step}</li>)}
      </ol>
      <p class="hs-soft m-0 mt-6 max-w-[60ch]">
        Home Stories is free on iPhone and iPad (iOS 17 or later). Projects, items, photos, notes, documents,
        time tracking, widgets, local backups and full data export are free. Pro is a single purchase with no
        subscription: the budget-vs-actual chart, task reminders, PDF export, iCloud sync and project sharing.
        Family Sharing included.
      </p>
    </section>

    <div class="max-w-[72ch]">
      <FaqSection items={feature.faq.map(({ q, a }) => ({ question: q, answer: a }))} />
    </div>

    {
      related.length > 0 && (
        <section class="mt-16" aria-labelledby="use-cases">
          <h2 id="use-cases" class="hs-lead m-0 font-semibold">Where it helps most</h2>
          <ul class="hs-grid m-0 mt-8 list-none gap-y-10 p-0">
            {related.map((useCase) => (
              <li class="col-span-12 m-0 sm:col-span-6 lg:col-span-3">
                <a href={`/use-cases/${useCase.slug}/`} class="group block">
                  <span class="block overflow-hidden">
                    <img
                      src={useCase.image}
                      alt=""
                      width={640}
                      height={480}
                      loading="lazy"
                      decoding="async"
                      class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  </span>
                  <span class="mt-3 block font-semibold group-hover:underline">{useCase.label}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <div class="hs-grid mt-24 gap-y-12 md:mt-32">
      <aside class="col-span-12 md:col-span-5">
        <h2 class="hs-lead m-0 font-semibold">Other features</h2>
        <ul class="m-0 mt-4 list-none space-y-2.5 p-0">
          <li class="m-0"><a href="/features/" class="hs-link">All features</a></li>
          {
            siblings.map((item) => (
              <li class="m-0">
                <a href={`/features/${item.slug}/`} class="hs-link">{item.label}</a>
              </li>
            ))
          }
        </ul>
      </aside>

      <aside class="hs-signal col-span-12 self-start p-7 sm:p-10 md:col-span-7">
        <h2 class="hs-lead m-0 font-semibold">Try it on your next project</h2>
        <p class="m-0 mt-3 max-w-[52ch]">
          Home Stories is a renovation tracker for iPhone and iPad. No account, works offline, free to start.
        </p>
        <a
          href={ctaUrl}
          class="hs-btn hs-btn--ink mt-6"
          data-umami-event="appstore-click"
          data-umami-event-surface="feature-footer"
          data-umami-event-slug={feature.slug}
        >
          Get Home Stories — free on the App Store
        </a>
      </aside>
    </div>
  </main>
</BlogLayout>
