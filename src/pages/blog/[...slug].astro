---
import { getCollection, type CollectionEntry } from "astro:content";
import { isPublished } from "../../utils/posts";
import BlogLayout from "../../layouts/BlogLayout.astro";
import TldrBox from "../../components/blog/TldrBox.astro";
import InlineCTA from "../../components/blog/InlineCTA.astro";
import FaqSection from "../../components/blog/FaqSection.astro";
import RelatedPosts from "../../components/blog/RelatedPosts.astro";
import AuthorBio from "../../components/blog/AuthorBio.astro";
import { readingTime } from "../../utils/readingTime";
import { TOPICS, topicFor } from "../../utils/blogCta.mjs";
import { guidesForSlug } from "../../data/guides";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => isPublished(data));
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
}

const { post, allPosts } = Astro.props as Props;
const { Content } = await post.render();
const { minutes } = readingTime(post.body);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });

const canonicalPath = `/blog/${post.slug}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);
const ogImage = post.data.ogImage ?? `/og/${post.slug}.png`;
// The transitional CTA offers whichever free download actually matches what
// the reader just read: the spreadsheet on a money post, the phase checklist
// otherwise. A post never offers its own download twice, since the body of
// those two already links it. Ungated — no form, no email. #119
const transitional = (() => {
  if (post.slug === "renovation-budget-template" || post.slug === "renovation-checklist-printable") {
    return { transitionalText: null };
  }
  if (post.data.tags?.includes("budgeting")) {
    return {
      transitionalText: "Not starting yet? Download the free budget template (XLSX)",
      transitionalHref: "/downloads/renovation-budget-template.xlsx",
    };
  }
  return {};
})();

const siteUrl = Astro.site?.href ?? "https://home-stories.12f.dk";

// End-of-post copy follows the post's topic instead of one budget sentence on
// all 31 posts (a roof-timeline post was being sold "spent vs committed").
// Deliberately different wording from the mid-article card (EDITORIAL_RULES §6).
const topic = TOPICS[topicFor({ slug: post.slug, keyword: post.data.keyword, tags: post.data.tags })];

// Explicit relatedSlugs win. The fallback used to take the first three posts in the
// collection, which is arbitrary — it linked a roof-timeline post to whatever happened
// to be newest. Falling back on shared tags means a post with no relatedSlugs still
// lands in the right cluster instead of being effectively orphaned. (#96)
const byTag = (a: (typeof allPosts)[number]) =>
  a.data.tags.filter((t) => post.data.tags.includes(t)).length;

const topicGuides = guidesForSlug(post.slug);

const related = (
  post.data.relatedSlugs.length > 0
    ? allPosts.filter((p) => post.data.relatedSlugs.includes(p.slug))
    : allPosts
        .filter((p) => p.slug !== post.slug && byTag(p) > 0)
        .sort(
          (a, b) =>
            byTag(b) - byTag(a) ||
            b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
        )
).slice(0, 3);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": ["Article", "BlogPosting"],
  headline: post.data.title,
  description: post.data.description,
  image: new URL(ogImage, Astro.site).href,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
  // A bare name and a company URL told answer engines nothing about why this
  // author is worth citing. jobTitle/description/knowsAbout plus a real author
  // page give the Person entity something to resolve against. See the
  // 2026-08-27 SEO audit.
  author: {
    "@type": "Person",
    name: post.data.author,
    url: new URL("/about/", Astro.site).href,
    jobTitle: "Software developer and renovator",
    description:
      "Built Home Stories after renovating his own house and running the whole project out of a spreadsheet. Writes about renovation planning, budgeting and documentation from direct experience.",
    knowsAbout: [
      "Home renovation planning",
      "Renovation budgeting",
      "Construction project sequencing",
      "Renovation documentation",
    ],
    sameAs: [
      "https://www.robert-jensen.dk",
      "https://github.com/12fdk",
      "https://apps.apple.com/developer/id1786807724",
    ],
  },
  publisher: {
    "@type": "Organization",
    name: "12f",
    url: "https://www.12f.dk",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.png", Astro.site).href,
    },
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonicalURL.href,
  },
  keywords: [post.data.keyword, ...post.data.tags].join(", "),
  inLanguage: "en",
  isPartOf: {
    "@type": "Blog",
    name: "Home Stories Blog",
    url: new URL("/blog/", Astro.site).href,
  },
};
---

<BlogLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  canonicalPath={canonicalPath}
  articleSchema={articleSchema}
  publishedTime={post.data.publishDate.toISOString()}
  modifiedTime={(post.data.updatedDate ?? post.data.publishDate).toISOString()}
  author={post.data.author}
  tags={[post.data.keyword, ...post.data.tags]}
>
  <article class="pb-20 pt-10 md:pb-28 md:pt-16">
    <div class="hs-wrap">
    <nav aria-label="Breadcrumb" class="hs-soft mb-10 md:mb-16">
      <a href="/" class="hover:underline">Home</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <a href="/blog/" class="hover:underline">Blog</a>
      {
        topicGuides.map((guide) => (
          <>
            <span class="mx-1.5" aria-hidden="true">/</span>
            <a href={`/guides/${guide.slug}/`} class="hover:underline">
              {guide.label}
            </a>
          </>
        ))
      }
    </nav>

    <header class="hs-grid gap-y-6">
      <h1 class="hs-title col-span-12 m-0 max-w-[34ch] lg:col-span-11" data-reveal>
        {post.data.title}
      </h1>
      <p class="hs-soft col-span-12 m-0" data-reveal style="--d: 60ms">
        By {post.data.author} · <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
        {post.data.updatedDate && <> · Updated {formatDate(post.data.updatedDate)}</>}
        {" · "}{minutes} min read
      </p>
      <p class="hs-lead col-span-12 m-0 max-w-[44ch] md:col-span-9" data-speakable data-reveal style="--d: 120ms">
        {post.data.lede}
      </p>
    </header>

    {post.data.cover && (
      <figure class="m-0 mt-12 overflow-hidden md:mt-16" data-reveal style="--d: 160ms">
        <img
          src={post.data.cover}
          alt={post.data.coverAlt ?? ""}
          width={1600}
          height={900}
          loading="eager"
          decoding="async"
          class="aspect-[16/9] w-full object-cover md:aspect-[21/9]"
        />
      </figure>
    )}
    </div>

    <div class="hs-post-body mx-auto mt-14 max-w-[46rem] px-5 md:mt-20">
    <TldrBox items={post.data.tldr} />

    <div class="hs-prose prose prose-lg max-w-none prose-headings:font-bold prose-headings:tracking-tight prose-h2:mt-14 prose-h2:text-3xl prose-h3:text-xl">
      <Content />
    </div>

    <InlineCTA
      heading="Ready to put this into practice?"
      body={topic.end}
      buttonText="Get Home Stories — Free on the App Store"
      slug={post.slug}
      {...transitional}
    />

    <FaqSection items={post.data.faq} />

    <AuthorBio name={post.data.author} />

    <RelatedPosts posts={related} />
    </div>
  </article>

  <script
    is:inline
    define:vars={{ slug: post.slug, siteUrl }}
  >
    // Track 60-second read for blog conversion KPI
    if (typeof window !== "undefined") {
      let fired = false;
      const fire = () => {
        if (fired) return;
        fired = true;
        if (window.umami && typeof window.umami.track === "function") {
          window.umami.track("blog-read-60s", { slug });
        }
      };
      const timer = window.setTimeout(fire, 60000);
      document.addEventListener(
        "visibilitychange",
        () => {
          if (document.visibilityState === "hidden") window.clearTimeout(timer);
        },
        { once: true }
      );

      // Prose links to the App Store come from post markdown, so they can't
      // carry data-umami-event attributes the way the CTA components do. They
      // are also the most-clicked route out of a post — the recommendation in
      // the middle of a paragraph — so leaving them untracked would understate
      // blog click-through badly.
      //
      // Bound explicitly rather than by stamping attributes on: Umami collects
      // its data-umami-event targets when the tracker loads, and these are
      // stamped after that, so a delegated binding would silently miss them.
      document.querySelectorAll('a[href*="apps.apple.com/app/id"]').forEach((link) => {
        if (link.hasAttribute("data-umami-event")) return; // a CTA card/box — already counted
        link.addEventListener("click", () => {
          if (window.umami && typeof window.umami.track === "function") {
            window.umami.track("appstore-click", {
              surface: "blog-prose",
              slug,
              path: location.pathname,
              "page-type": "blog-post",
            });
          }
        });
      });

      // The two posts that ship their own file link it from markdown prose,
      // so the same attribute problem applies — and these are the highest
      // intent downloads on the site, since the reader came for that exact
      // file. Untracked, they would be invisible. #119
      document.querySelectorAll('a[href^="/downloads/"]').forEach((link) => {
        if (link.hasAttribute("data-umami-event")) return; // the transitional CTA
        link.addEventListener("click", () => {
          if (window.umami && typeof window.umami.track === "function") {
            const file = link.getAttribute("href").split("/").pop();
            window.umami.track("download", { surface: "blog-prose", file, slug });
          }
        });
      });
    }
  </script>
</BlogLayout>
