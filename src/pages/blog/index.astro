---
import { getCollection } from "astro:content";
import { isPublished } from "../../utils/posts";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { readingTime } from "../../utils/readingTime";

const allPosts = (await getCollection("blog", ({ data }) => isPublished(data))).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const postsWithMeta = await Promise.all(
  allPosts.map(async (post) => ({
    post,
    minutes: readingTime(post.body).minutes,
  })),
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

// The index enumerated 29 articles in HTML but declared nothing about them in
// structured data, so a crawler had no machine-readable signal that this is a
// collection or what it holds. Blog + ItemList give it both. See the
// 2026-08-27 SEO audit.
const siteUrl = Astro.site?.href ?? "https://home-stories.12f.dk";
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": new URL("/blog/", Astro.site).href,
  name: "Home Stories Blog",
  description:
    "Practical, evidence-based guides on planning, budgeting, sequencing and documenting home renovations.",
  url: new URL("/blog/", Astro.site).href,
  inLanguage: "en",
  publisher: {
    "@type": "Organization",
    name: "12f",
    url: "https://www.12f.dk",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.png", Astro.site).href,
    },
  },
  blogPost: postsWithMeta.map(({ post }) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    url: new URL(`/blog/${post.slug}/`, Astro.site).href,
    datePublished: post.data.publishDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
    author: { "@type": "Person", name: post.data.author },
  })),
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Home Stories Blog posts",
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  numberOfItems: postsWithMeta.length,
  itemListElement: postsWithMeta.map(({ post }, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/blog/${post.slug}/`, Astro.site).href,
    name: post.data.title,
  })),
};
---

<BlogLayout
  title="Home Renovation Blog — Budgeting & Planning | Home Stories"
  description="Practical, no-fluff guides on planning, budgeting, sequencing and documenting a home renovation. Real numbers and templates, from someone who lived it."
  canonicalPath="/blog/"
  extraSchema={[blogSchema, itemListSchema]}
  hideAppBanner={true}
>
  <main class="max-w-screen-lg mx-auto px-4 py-12 md:py-20">
    <header class="mb-14 max-w-3xl">
      <p class="tick-label m-0 flex items-center gap-3 text-base-content/50">
        <span class="inline-block h-0.5 w-8 bg-accent"></span>
        Home Stories Blog
      </p>
      <h1 class="mb-4 mt-5 font-display text-4xl font-extrabold leading-[1.05] tracking-tightest md:text-5xl">
        Plan, budget, and survive your renovation.
      </h1>
      <p class="text-lg leading-relaxed text-base-content/70">
        Practical guides for homeowners who'd rather track a renovation in
        something better than a spreadsheet. Real numbers, real templates, no
        fluff.
      </p>
    </header>

    {
      postsWithMeta.length === 0 ? (
        <p class="text-base-content/60">No posts yet — coming soon.</p>
      ) : (
        <ul class="grid list-none gap-8 p-0 md:grid-cols-2">
          {postsWithMeta.map(({ post, minutes }, index) => (
            <li class="group m-0 overflow-hidden rounded-box border border-base-300 bg-base-100 p-0 transition-colors hover:border-base-content/30">
              <a href={`/blog/${post.slug}/`} class="flex h-full flex-col">
                {post.data.cover && (
                  <div class="overflow-hidden border-b border-base-300 bg-base-200">
                    <img
                      src={post.data.cover}
                      alt={post.data.coverAlt ?? ""}
                      width={640}
                      height={360}
                      loading={index < 2 ? "eager" : "lazy"}
                      decoding="async"
                      class="aspect-[16/9] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    />
                  </div>
                )}
                <div class="flex flex-1 flex-col p-6 sm:p-7">
                  <div class="tick-label flex flex-wrap items-center gap-x-2 gap-y-1 text-base-content/40">
                    <time datetime={post.data.publishDate.toISOString()}>
                      {formatDate(post.data.publishDate)}
                    </time>
                    <span aria-hidden="true">·</span>
                    <span>{minutes} min</span>
                    {post.data.tags.slice(0, 2).map((tag) => (
                      <>
                        <span aria-hidden="true">·</span>
                        <span>{tag}</span>
                      </>
                    ))}
                  </div>
                  <h2 class="mb-0 mt-3 font-display text-xl font-bold leading-snug tracking-tight text-base-content transition-colors group-hover:text-primary sm:text-2xl">
                    {post.data.title}
                  </h2>
                  <p class="mt-3 text-base leading-relaxed text-base-content/70">
                    {post.data.description}
                  </p>
                  <span class="tick-label mt-5 inline-block self-start border-b-2 border-accent pb-1 text-base-content">
                    Read more
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </main>
</BlogLayout>
