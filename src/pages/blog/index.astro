---
import { getCollection } from "astro:content";
import { isPublished } from "../../utils/posts";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { readingTime } from "../../utils/readingTime";
import { guides } from "../../data/guides";

const allPosts = (await getCollection("blog", ({ data }) => isPublished(data))).sort(
  (a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime(),
);

const postsWithMeta = await Promise.all(
  allPosts.map(async (post) => ({
    post,
    minutes: readingTime(post.body).minutes,
  })),
);

const [latest, ...rest] = postsWithMeta;

const formatDate = (d: Date) =>
  d.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  });

// The index enumerated 29 articles in HTML but declared nothing about them in
// structured data, so a crawler had no machine-readable signal that this is a
// collection or what it holds. Blog + ItemList give it both. See the
// 2026-08-27 SEO audit.
const siteUrl = Astro.site?.href ?? "https://home-stories.12f.dk";
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": new URL("/blog/", Astro.site).href,
  name: "Home Stories Blog",
  description:
    "Practical, evidence-based guides on planning, budgeting, sequencing and documenting home renovations.",
  url: new URL("/blog/", Astro.site).href,
  inLanguage: "en",
  publisher: {
    "@type": "Organization",
    name: "12f",
    url: "https://www.12f.dk",
    logo: {
      "@type": "ImageObject",
      url: new URL("/logo.png", Astro.site).href,
    },
  },
  blogPost: postsWithMeta.map(({ post }) => ({
    "@type": "BlogPosting",
    headline: post.data.title,
    description: post.data.description,
    url: new URL(`/blog/${post.slug}/`, Astro.site).href,
    datePublished: post.data.publishDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.publishDate).toISOString(),
    author: { "@type": "Person", name: post.data.author },
  })),
};

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Home Stories Blog posts",
  itemListOrder: "https://schema.org/ItemListOrderDescending",
  numberOfItems: postsWithMeta.length,
  itemListElement: postsWithMeta.map(({ post }, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: new URL(`/blog/${post.slug}/`, Astro.site).href,
    name: post.data.title,
  })),
};
---

<BlogLayout
  title="Home Renovation Blog — Budgeting & Planning | Home Stories"
  description="Practical, no-fluff guides on planning, budgeting, sequencing and documenting a home renovation. Real numbers and templates, from someone who lived it."
  canonicalPath="/blog/"
  extraSchema={[blogSchema, itemListSchema]}
  hideAppBanner={true}
>
  <main class="hs-wrap pb-24 pt-16 md:pb-36 md:pt-24">
    <header class="hs-grid gap-y-8">
      <h1 class="hs-display col-span-12 m-0" style="--chars: 21" data-reveal>
        The renovation blog.
      </h1>
      <p class="hs-lead col-span-12 m-0 max-w-[40ch] md:col-span-7" data-reveal style="--d: 80ms">
        Plan, budget, and survive your renovation. Practical guides for homeowners
        who'd rather track it in something better than a spreadsheet. Real
        numbers, real templates, no fluff.
      </p>
    </header>

    {latest && (
      <a href={`/blog/${latest.post.slug}/`} class="hs-feature hs-grid mt-16 gap-y-8 md:mt-24" data-reveal style="--d: 140ms">
        {latest.post.data.cover && (
          <span class="col-span-12 block overflow-hidden md:col-span-6">
            <img
              src={latest.post.data.cover}
              alt={latest.post.data.coverAlt ?? ""}
              width={1280}
              height={720}
              loading="eager"
              decoding="async"
              class="aspect-[16/10] w-full object-cover"
            />
          </span>
        )}
        <span class="col-span-12 self-end md:col-span-6">
          <p class="hs-lead m-0 max-w-[30ch] font-semibold">{latest.post.data.title}</p>
          <p class="m-0 mt-4 max-w-[46ch]">{latest.post.data.description}</p>
          <p class="hs-soft m-0 mt-3">
            Newest article, {formatDate(latest.post.data.publishDate)} · {latest.minutes} min
          </p>
        </span>
      </a>
    )}

    <section aria-labelledby="guides-heading" class="hs-grid mt-24 gap-y-8 md:mt-36">
      <div class="col-span-12 md:col-span-4">
        <h2 id="guides-heading" class="hs-head m-0" data-reveal>Guides by topic</h2>
        <p class="m-0 mt-4 max-w-[34ch]" data-reveal style="--d: 80ms">
          The same articles, grouped by the job: the budget, the contractor, the timeline, and the tool.
        </p>
      </div>
      <ul class="col-span-12 m-0 grid list-none gap-x-7 gap-y-2 p-0 sm:grid-cols-2 md:col-span-8">
        {
          guides.map((guide, i) => (
            <li class="m-0" data-reveal style={`--d: ${(i % 4) * 60}ms`}>
              <a href={`/guides/${guide.slug}/`} class="hs-row block py-4">
                <span class="hs-lead block font-semibold">{guide.label}</span>
                <span class="hs-soft block">{guide.posts.length} articles</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="all-heading" class="mt-24 md:mt-36">
      <h2 id="all-heading" class="hs-head m-0" data-reveal>Every article</h2>
      {
        rest.length === 0 && !latest ? (
          <p class="hs-soft mt-6">No posts yet — coming soon.</p>
        ) : (
          <ul class="m-0 mt-12 list-none space-y-3 p-0">
            {rest.map(({ post, minutes }) => (
              <li class="m-0 p-0" data-reveal>
                <a href={`/blog/${post.slug}/`} class="hs-row hs-grid items-center gap-y-4 py-5">
                  {post.data.cover && (
                    <span class="col-span-12 block overflow-hidden sm:col-span-4 md:col-span-3">
                      <img
                        src={post.data.cover}
                        alt={post.data.coverAlt ?? ""}
                        width={640}
                        height={400}
                        loading="lazy"
                        decoding="async"
                        class="aspect-[16/10] w-full object-cover transition-transform duration-500 ease-out"
                      />
                    </span>
                  )}
                  <span class="col-span-12 sm:col-span-8 md:col-span-9 lg:col-span-6">
                    <span class="hs-lead block font-semibold">{post.data.title}</span>
                    <span class="mt-2 block">{post.data.description}</span>
                    <span class="hs-soft mt-2 block">
                      <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
                      {" · "}{minutes} min{post.data.tags.length ? ` · ${post.data.tags.slice(0, 2).join(", ")}` : ""}
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</BlogLayout>
