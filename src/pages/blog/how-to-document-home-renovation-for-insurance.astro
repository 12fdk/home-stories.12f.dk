    <link rel="canonical" href={target} />
    <title>Moved Permanently</title>
    <script>
      window.location.replace("https://home-stories.12f.dk/blog/documenting-renovation-for-insurance/");
    </script>
  </head>
  <body>
    <p>This page has moved.
      <a href={target}>Click here if you are not redirected.</a></p>
  </body>
</html>
