---
interface Props {
  name?: string;
  bio?: string;
  avatarUrl?: string;
}

const {
  name = "Robert Jensen",
  bio = "Robert is the developer of Home Stories and has lived through several renovation projects of his own — kitchen, bathroom, and a full attic conversion. He built the app because nothing he tried (spreadsheets, Notion, generic project apps) stayed useful past week two.",
  avatarUrl,
} = Astro.props;
---

<aside class="not-prose my-14 flex flex-col items-start gap-5 bg-base-200 p-6 sm:flex-row sm:items-center sm:p-8">
  {
    avatarUrl && (
      <img
        src={avatarUrl}
        alt={`${name}, author`}
        width="72"
        height="72"
        loading="lazy"
        class="h-18 w-18 flex-shrink-0 rounded-full object-cover"
      />
    )
  }
  <div>
    <p class="hs-soft mb-1">
      Written by
    </p>
    <p class="text-lg font-bold">{name}</p>
    <p class="mt-1">{bio}</p>
  </div>
</aside>
