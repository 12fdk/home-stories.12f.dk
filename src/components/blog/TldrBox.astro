---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <aside
      class="not-prose my-10 bg-base-200 p-6 sm:p-8"
      data-speakable
      aria-label="Article summary"
    >
      <p class="hs-lead mb-4 font-semibold text-base-content">
        TL;DR
      </p>
      <ul class="space-y-2 text-base-content">
        {items.map((item) => (
          <li class="flex gap-2">
            <span class="text-base-content" aria-hidden="true">
              ▸
            </span>
            <span set:html={item} />
          </li>
        ))}
      </ul>
    </aside>
  )
}
