---
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="not-prose my-16">
      <h2 class="mb-6 text-2xl font-bold sm:text-3xl">Keep reading</h2>
      <ul class="grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <li class="group m-0 overflow-hidden p-0">
            <a href={`/blog/${post.slug}/`} class="flex h-full flex-col">
              {post.data.cover && (
                <img
                  src={post.data.cover}
                  alt={post.data.coverAlt ?? ""}
                  width={400}
                  height={225}
                  loading="lazy"
                  decoding="async"
                  class="aspect-[16/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
                />
              )}
              <div class="pt-4">
                <h3 class="mb-2 text-lg font-semibold tracking-tight text-base-content group-hover:underline">
                  {post.data.title}
                </h3>
                <p class="leading-relaxed text-base-content">
                  {post.data.description}
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )
}
