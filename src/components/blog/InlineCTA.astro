---
import { APP_STORE_CLICK_EVENT } from "../../utils/tracking";

type Variant = "inline" | "callout";

interface Props {
  variant?: Variant;
  heading?: string;
  body?: string;
  buttonText?: string;
  /**
   * Which post this CTA sits in. Recorded as an event *property* rather than
   * folded into the event name, so every App Store click on the site still
   * rolls up under one `appstore-click` total instead of fragmenting into 25
   * separate Umami events that each have to be read and summed by hand.
   */
  slug?: string;
  appStoreLink?: string;
  /**
   * The transitional CTA: a lower-commitment next step for the reader who is
   * three weeks from starting and will not install an app today. Keeps them in
   * the story instead of dropping them at a download they are not ready for.
   *
   * It is an ungated direct download — no form, no email, no signup. There is
   * no mailing list on this site and none is planned. #119
   *
   * Pass `null` to suppress it. #117
   */
  transitionalText?: string | null;
  transitionalHref?: string;
  /** Set for a direct file download so the browser saves rather than navigates. */
  transitionalDownload?: boolean;
}

const {
  variant = "callout",
  heading = "Stop wrangling spreadsheets",
  body = "Home Stories tracks budgets, tasks, and photos in one place — and it's free on the App Store.",
  buttonText = "Get Home Stories — Free",
  slug,
  appStoreLink = "https://apps.apple.com/app/id6754754960",
  transitionalText = "Not starting yet? Download the free phase checklist (PDF)",
  transitionalHref = "/downloads/renovation-checklist.pdf",
  transitionalDownload = true,
} = Astro.props;

const track = {
  "data-umami-event": APP_STORE_CLICK_EVENT,
  "data-umami-event-surface": "blog-inline-cta",
  ...(slug ? { "data-umami-event-slug": slug } : {}),
};
---

{
  variant === "inline" ? (
    <p class="not-prose my-6">
      <a
        href={appStoreLink}
        target="_blank"
        rel="noopener"
        {...track}
        class="link link-primary font-semibold"
      >
        {body}
      </a>
    </p>
  ) : (
    <aside
      class="not-prose my-10 rounded-2xl border border-base-300 bg-base-200 p-6 sm:p-8"
      data-cta-id={slug ? `blog-cta-end-${slug}` : "blog-inline-cta"}
    >
      <h3 class="mb-2 text-xl font-bold text-base-content sm:text-2xl">{heading}</h3>
      <p class="mb-5 text-base-content/80">{body}</p>
      <a
        href={appStoreLink}
        target="_blank"
        rel="noopener"
        {...track}
        class="btn btn-primary"
      >
        {buttonText}
      </a>
      {
        transitionalText && (
          <p class="mb-0 mt-4 text-sm">
            <a
              href={transitionalHref}
              download={transitionalDownload ? "" : undefined}
              class="text-base-content/60 underline-offset-4 hover:text-base-content"
            >
              {transitionalText} ↓
            </a>
          </p>
        )
      }
    </aside>
  )
}
