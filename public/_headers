# ⚠️  INERT ON GITHUB PAGES — THIS FILE DOES NOTHING TODAY.
#
# `_headers` is a Netlify / Cloudflare Pages convention. GitHub Pages does not
# read it, so none of the rules below are applied. Verified 2026-08-27: the live
# response for / returns `cache-control: max-age=600` (the GitHub Pages default),
# not the 31536000 this file asks for.
#
# It is kept as the source of truth for the intended caching policy. To actually
# apply it, run ./scripts/cloudflare-headers.sh, which writes these rules (and
# the security headers the site currently ships without) to Cloudflare, scoped
# to this hostname. See docs/edge-headers.md.
#
# Cache static assets for 1 year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/screenshots/*
  Cache-Control: public, max-age=31536000, immutable

/3D/*
  Cache-Control: public, max-age=31536000, immutable

/stock/*
  Cache-Control: public, max-age=31536000, immutable

/avatars/*
  Cache-Control: public, max-age=31536000, immutable

/misc/*
  Cache-Control: public, max-age=31536000, immutable

/stores/*
  Cache-Control: public, max-age=31536000, immutable

# Cache HTML pages for 1 hour
/*.html
  Cache-Control: public, max-age=3600

# Cache CSS and JS for 1 year (they have hashes)
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# LLM/AI content files
/llms.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

/llms-full.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8
